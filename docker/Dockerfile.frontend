FROM node:22-alpine AS build

WORKDIR /app

COPY code/frontend/package*.json ./

RUN npm ci && npm cache clean --force

COPY code/frontend/index.html ./
COPY code/frontend/public ./public
COPY code/frontend/src ./src
COPY code/frontend/tsconfig*.json ./
COPY code/frontend/vite.config.ts ./
COPY code/frontend/vitest.config.ts ./

ARG VITE_API_URL=/api
ENV VITE_API_URL=$VITE_API_URL

RUN npm run build

FROM nginx:stable-alpine3.21 AS production

COPY --from=build /app/build /usr/share/nginx/html

COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

COPY docker/docker-entrypoint.d/10-app-config.sh /docker-entrypoint.d/10-app-config.sh
RUN chmod +x /docker-entrypoint.d/10-app-config.sh

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://127.0.0.1/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
